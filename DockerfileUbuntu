FROM ubuntu:latest AS buildenv

# Default to using ASAN
ARG NO_SANITIZERS=0
ARG NODE_MAJOR=22
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc protobuf-c-compiler build-essential git zip curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs

COPY . /buildenv
WORKDIR /buildenv

RUN test -f cJSON/cJSON.h \
    && test -f ogg/src/framing.c \
    && test -f opus/opus_headers.mk \
    && test -f teddycloud_web/package.json \
    || (echo "Missing required submodule content. Run: git submodule update --init --recursive" >&2 && exit 1)

# Capture version info from the clean checkout BEFORE build steps dirty the tree.
# make web regenerates web_version.json, make zip runs protoc-c (different version),
# and the curl below writes into contrib/config/ — all of which modify tracked files.
RUN git diff --quiet 2>/dev/null && echo 0 > /tmp/git_dirty || echo 1 > /tmp/git_dirty \
    && git log -1 --format=%ai 2>/dev/null > /tmp/git_datetime \
    && git rev-parse --short HEAD 2>/dev/null > /tmp/git_short_sha \
    && git rev-parse HEAD 2>/dev/null > /tmp/git_sha \
    && (git describe --tags --exact-match 2>/dev/null || git describe --tags --always 2>/dev/null) > /tmp/git_tag \
    && cd teddycloud_web \
    && git diff --quiet 2>/dev/null && echo 0 > /tmp/web_dirty || echo 1 > /tmp/web_dirty \
    && git log -1 --format=%ai 2>/dev/null > /tmp/web_datetime \
    && git rev-parse --short HEAD 2>/dev/null > /tmp/web_short_sha \
    && git rev-parse HEAD 2>/dev/null > /tmp/web_sha \
    && (git describe --tags --exact-match 2>/dev/null || git describe --tags --always 2>/dev/null) > /tmp/web_tag

RUN curl -f https://raw.githubusercontent.com/privatecoder/tonies-json/release/tonies.json -o /buildenv/contrib/config/tonies.json || true
RUN curl -f https://raw.githubusercontent.com/privatecoder/tonies-json/release/tonieboxes.json -o /buildenv/contrib/config/tonieboxes.json || true
RUN make web \
    WEB_GIT_DIRTY="$(cat /tmp/web_dirty)" \
    WEB_GIT_BUILD_TIME="$(cat /tmp/web_datetime)" \
    WEB_GIT_SHORT_SHA="$(cat /tmp/web_short_sha)" \
    WEB_GIT_SHA="$(cat /tmp/web_sha)" \
    WEB_GIT_TAG="$(cat /tmp/web_tag)"
RUN make zip NO_SANITIZERS=${NO_SANITIZERS} \
    GIT_DIRTY="$(cat /tmp/git_dirty)" \
    GIT_BUILD_TIME="$(cat /tmp/git_datetime)" \
    GIT_SHORT_SHA="$(cat /tmp/git_short_sha)" \
    GIT_SHA="$(cat /tmp/git_sha)" \
    GIT_TAG="$(cat /tmp/git_tag)" \
    WEB_GIT_DIRTY="$(cat /tmp/web_dirty)" \
    WEB_GIT_BUILD_TIME="$(cat /tmp/web_datetime)" \
    WEB_GIT_SHORT_SHA="$(cat /tmp/web_short_sha)" \
    WEB_GIT_SHA="$(cat /tmp/web_sha)" \
    WEB_GIT_TAG="$(cat /tmp/web_tag)"

FROM ubuntu:latest
ARG TEDDYCLOUD_VERSION=unknown
LABEL org.opencontainers.image.version=$TEDDYCLOUD_VERSION
EXPOSE 80 443 8443

RUN apt-get update \
    && apt-get install -y --no-install-recommends libubsan1 strace ffmpeg curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-ca-certificates

RUN mkdir -p /teddycloud/certs \
    && mkdir /teddycloud/config \
    && mkdir -p /teddycloud/data/content/default \
    && mkdir -p /teddycloud/data/library \
    && mkdir -p /teddycloud/data/firmware  \
    && mkdir -p /teddycloud/data/www \
    && mkdir -p /teddycloud/data/www/custom_img \
    && mkdir -p /teddycloud/data/www/plugins \
    && mkdir -p /teddycloud/data/cache \
    && mkdir -p /tmp

RUN ln -s /teddycloud /etc/teddycloud

COPY --from=buildenv \
    /buildenv/install/pre/certs/ /teddycloud/certs/
COPY --from=buildenv \
    /buildenv/install/pre/data/www/ /teddycloud/data/www/

COPY --from=buildenv \
    /buildenv/install/pre/*.sh /usr/local/bin/
COPY --from=buildenv \
    /buildenv/install/pre/teddycloud /usr/local/bin/teddycloud

COPY --from=buildenv /buildenv/install/zip/release.zip /tmp/teddycloud.zip

VOLUME \
    "/teddycloud/data/content" \
    "/teddycloud/data/library" \
    "/teddycloud/data/firmware" \
    "/teddycloud/data/cache" \
    "/teddycloud/data/www/custom_img" \
    "/teddycloud/data/www/plugins" \
    "/teddycloud/certs" \
    "/teddycloud/config"

COPY docker/docker-entrypoint.sh /
RUN chmod +rx /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
